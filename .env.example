# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ──────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK — server-side credentials
#
# These are NOT the same as the client-side Firebase config (apiKey, authDomain,
# etc.).  You must generate a service-account key specifically for the backend:
#
#   1. Go to: https://console.firebase.google.com/project/drexorasupport/settings/serviceaccounts/adminsdk
#   2. Click "Generate new private key" → download the JSON file
#   3. Copy the three values below from that JSON file
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=drexorasupport
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@drexorasupport.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────────────────────────────────────
# Firebase Realtime Database URL (already set for your project)
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_DATABASE_URL=https://drexorasupport-default-rtdb.firebaseio.com

# ──────────────────────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# Add your GitHub Pages URL.  The authDomain is already known for your project.
# ──────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://daviddchucks-hash.github.io,http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ──────────────────────────────────────────────────────────────────────────────
# Firebase client-side config (for reference — used in your frontend JS, NOT here)
#
# apiKey:            AIzaSyA1wX_0tastbk_hWfI0_cvuV9ZzoIKitL4
# authDomain:        drexorasupport.firebaseapp.com
