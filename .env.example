# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ──────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK — server-side credentials
#
# NEVER put real values in this file — it is committed to the public repo.
# Set the real values ONLY in the Render dashboard (Environment tab).
#
# How to get these:
#   Firebase Console → Project Settings → Service accounts
#   → Generate new private key → download JSON → copy the fields below
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=drexorasupport
FIREBASE_CLIENT_EMAIL=your-service-account@drexorasupport.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────────────────────────────────────
# Firebase Realtime Database URL
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_DATABASE_URL=https://drexorasupport-default-rtdb.firebaseio.com

# ──────────────────────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# ──────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://daviddchucks-hash.github.io,http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
