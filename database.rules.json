{
  "rules": {
    "businesses": {
      "$uid": {
        "profile": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid"
        },
        "faqs": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid"
        },
        "chats": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": true,
          "$chatId": {
            ".read": true,
            ".write": true
          }
        },
        "leads": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": true
        },
        "team": {
          "members": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "$memberId": {
              ".read": "auth != null && (auth.uid === $uid || auth.uid === $memberId)",
              ".write": "auth != null && (auth.uid === $uid || auth.uid === $memberId)"
            }
          },
          "invitations": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "$inviteId": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && (auth.uid === $uid || (auth != null && root.child('pendingInvitations').child(auth.token.email.replace(/[.]/g, ',')).child($inviteId).exists()))"
            }
          }
        },
        "tickets": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$ticketId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "messages": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid"
            },
            "notes": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "ticketCounter": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "pendingInvitations": {
      "$encodedEmail": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
