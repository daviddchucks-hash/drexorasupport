{
  "rules": {
    "businesses": {
      "$uid": {
        "profile": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid"
        },
        "faqs": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid"
        },
        "chats": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": true
        },
        "leads": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": true
        }
      }
    }
  }
}
