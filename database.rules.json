{
  "rules": {

    /* ── userWorkspace lookup ─────────────────────────────── */
    "userWorkspace": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === root.child('userWorkspace').child($uid).child('businessUid').val())"
      }
    },

    /* ── Business data ─────────────────────────────────────── */
    "businesses": {
      "$businessUid": {

        /* Profile and FAQs are publicly readable (needed by the widget) */
        "profile": {
          ".read":  true,
          ".write": "auth != null && (auth.uid === $businessUid || (root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid && (root.child('userWorkspace').child(auth.uid).child('role').val() === 'owner' || root.child('userWorkspace').child(auth.uid).child('role').val() === 'admin')))"
        },
        "faqs": {
          ".read":  true,
          ".write": "auth != null && (auth.uid === $businessUid || (root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid && (root.child('userWorkspace').child(auth.uid).child('role').val() === 'owner' || root.child('userWorkspace').child(auth.uid).child('role').val() === 'admin')))"
        },

        /* Chats: public write (widget visitors), workspace-member read */
        "chats": {
          ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
          ".write": true,
          "$chatId": {
            ".read":  true,
            ".write": true
          }
        },

        /* Leads: workspace members only */
        "leads": {
          ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
          ".write": true
        },

        /* Tickets: all workspace members can read (agents see their assigned
           tickets in Workspace > My Queue) but only owner/admin/agent can
           write — viewers are read-only.                                      */
        "tickets": {
          ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
          ".write": "auth != null && (auth.uid === $businessUid || (root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid && root.child('userWorkspace').child(auth.uid).child('role').val() !== 'viewer'))"
        },

        "ticketCounter": {
          ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
          ".write": "auth != null && (auth.uid === $businessUid || (root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid && root.child('userWorkspace').child(auth.uid).child('role').val() !== 'viewer'))"
        },

        /* Team members: all workspace members can read (needed for dropdowns
           and workspace board), but only owner/admin can manage the team.
           Each member can update their own record for presence (status,
           lastActive) even if they are a plain agent.                         */
        "team": {
          "members": {
            ".read": "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
            ".write": "auth != null && (auth.uid === $businessUid || (root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid && (root.child('userWorkspace').child(auth.uid).child('role').val() === 'owner' || root.child('userWorkspace').child(auth.uid).child('role').val() === 'admin')))",
            "$memberId": {
              ".read":  "auth != null && (auth.uid === $businessUid || auth.uid === $memberId || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
              /* Owner/admin can manage any member; a member can update their
                 own record (presence: status, lastActive, photoUrl).          */
              ".write": "auth != null && (auth.uid === $businessUid || auth.uid === $memberId || (root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid && (root.child('userWorkspace').child(auth.uid).child('role').val() === 'owner' || root.child('userWorkspace').child(auth.uid).child('role').val() === 'admin')))"
            }
          },
          /* Invitations: only owner/admin can send or revoke invitations      */
          "invitations": {
            ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
            ".write": "auth != null && (auth.uid === $businessUid || (root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid && (root.child('userWorkspace').child(auth.uid).child('role').val() === 'owner' || root.child('userWorkspace').child(auth.uid).child('role').val() === 'admin')))",
            "$inviteId": {
              ".read":  "auth != null",
              ".write": "auth != null"
            }
          }
        },

        /* Settings: only owner/admin can change workspace configuration.
           Agents and viewers have no legitimate reason to write settings.     */
        "settings": {
          ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
          ".write": "auth != null && (auth.uid === $businessUid || (root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid && (root.child('userWorkspace').child(auth.uid).child('role').val() === 'owner' || root.child('userWorkspace').child(auth.uid).child('role').val() === 'admin')))"
        },

        /* Activity log: workspace members */
        "activityLog": {
          ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
          ".write": "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)"
        },

        /* Notifications: workspace members */
        "notifications": {
          ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
          ".write": "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
          "$targetUid": {
            ".read":  "auth != null && (auth.uid === $businessUid || auth.uid === $targetUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
            ".write": "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)"
          }
        },

        /* ── Workspace: team feed and collaboration ─────────── */
        "workspace": {
          /* Team feed: all workspace members can read and post */
          "teamFeed": {
            ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
            ".write": "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
            "$postId": {
              ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
              ".write": "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
              /* Any member can mark a post as read (write to readBy/{uid} only) */
              "readBy": {
                "$readerUid": {
                  ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
                  ".write": "auth != null && (auth.uid === $readerUid || auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)"
                }
              },
              /* Replies: any workspace member can add */
              "replies": {
                ".read":  "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)",
                ".write": "auth != null && (auth.uid === $businessUid || root.child('userWorkspace').child(auth.uid).child('businessUid').val() === $businessUid)"
              }
            }
          }
        }

      }
    },

    /* ── Pending invitations (cross-workspace lookup) ──────── */
    "pendingInvitations": {
      "$encodedEmail": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
