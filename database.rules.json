{
  "rules": {
    "businesses": {
      "$uid": {
        "profile": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid"
        },
        "faqs": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid"
        },
        "chats": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": true,
          "$chatId": {
            ".read": true,
            ".write": true
          }
        },
        "leads": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": true
        },
        "team": {
          "members": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "$memberId": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "invitations": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "$inviteId": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "tickets": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$ticketId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "messages": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid"
            },
            "notes": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "ticketCounter": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
